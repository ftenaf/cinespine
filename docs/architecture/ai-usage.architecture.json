  "cards": [
    {
      "dot": "cyan",
      "title": "Generative uses",
      "items": [
        "Character profiles, shot breakdowns and DoP preset copy are Gemini Flash JSON with a deterministic fallback when the model is unavailable",
        "Portraits and storyboards try three Gemini image models, then serve a labelled placeholder rather than a fake render"
      ]
    },
    {
      "dot": "amber",
      "title": "Reading, not writing",
      "items": [
        "Uploads are classified by Gemini Flash plus rules; camera reports go through vision; Document AI, Speech and Video Intelligence extract text from scans, audio and footage",
        "The discrepancy assistant explains a take from spine facts; it never edits them"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agents and guardrails",
      "items": [
        "Wrap Rescue is an ADK LlmAgent that reaches ClickHouse only through cinespine-mcp; the AE Queue agent is deterministic and uses no model",
        "summarize_production_status gives an agent one ranked answer (done, running, blocking, left, missing; severity then age); llm_router walks four Gemini models on 503 and caches by prompt hash"
      ]
    }
  ]
