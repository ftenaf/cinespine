  "cards": [
    {
      "dot": "amber",
      "title": "The bus is in-process",
      "items": [
        "No broker: the spine is the append-only log; a handler that fails raises EventHandlerError, so no 200 INGESTED covers a lost write",
        "Rejected documents go to production.events.dlq, which only feeds telemetry"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two agents, two shapes",
      "items": [
        "Wrap Rescue is an ADK LlmAgent run by a crew member for a shoot day; it reads ClickHouse only through cinespine-mcp and drafts with Gemini",
        "The Assistant Editor Queue is deterministic: paperwork present, offload evidence, no open blockers; both write requirements into SQLite"
      ]
    },
    {
      "dot": "cyan",
      "title": "What people see",
      "items": [
        "Every requirement, tag and resolution publishes a SpineLiveEvent over SSE, addressed by @handle",
        "The activity ledger records every mutation, agent runs included"
      ]
    }
  ]
