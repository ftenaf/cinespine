  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Browser calls same-origin /api on one Cloud Run instance; live updates return over SSE",
        "Every write lands in spine.db first; ClickHouse is a best-effort mirror"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "The Cloud Run URL is public and unauthenticated; identity is a self-declared @handle",
        "Only the cinespine-run service account reads secrets and the replica bucket; ClickHouse and Grafana are external SaaS over TLS"
      ]
    },
    {
      "dot": "amber",
      "title": "Durability and agents",
      "items": [
        "max-instances=1 is an invariant: two Litestream writers corrupt the replica; a revision restores before uvicorn starts and never starts empty",
        "Wrap Rescue reaches ClickHouse only through cinespine-mcp; Gemini calls use a 4-model fallback router"
      ]
    }
  ]
