# syntax=docker/dockerfile:1
#
# CineSpine as a single Cloud Run service.
#
# One image, one origin: FastAPI serves the API under /api and the compiled SPA
# at everything else, which backend/app/main.py already does. Splitting the
# frontend onto its own host would buy a CDN and cost a second origin --
# meaning CORS between the two, a second entry in the Faro collector's
# allowed-origins list, and a second thing to deploy.
#
# Kept separate from backend/Dockerfile, which docker-compose still uses for
# local development. That one builds no frontend and installs --all-extras so
# the compose file can run a local mcp-clickhouse container; neither applies
# here.
#
# Build from the repository root:
#   docker build -f Dockerfile.cloudrun --build-arg VITE_GRAFANA_FARO_URL=... .

# --------------------------------------------------------------------------- #
# Stage 1 -- compile the SPA
# --------------------------------------------------------------------------- #
FROM node:20-alpine AS frontend

# Vite inlines VITE_* at build time, so anything the browser needs must be
# present HERE. Setting it on the Cloud Run service instead does nothing: by
# then the bundle is already written, and the app silently runs without it --
# `main.tsx` skips Faro entirely when the URL is absent.
#
# No VITE_API_URL: the API is same-origin in this shape, so the default
# relative `/api` in frontend/src/api.ts is correct and needs no build arg.
ARG VITE_GRAFANA_FARO_URL
ENV VITE_GRAFANA_FARO_URL=$VITE_GRAFANA_FARO_URL
# The revision this image was built from, so the browser's Faro app.version
# and the backend's service.version say the same thing as the image tag.
ARG GIT_SHA=unknown
ENV VITE_APP_VERSION=$GIT_SHA

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

COPY frontend/ ./
RUN npm run build

# --------------------------------------------------------------------------- #
# Stage 2 -- the service
# --------------------------------------------------------------------------- #
FROM python:3.11-slim
ARG GIT_SHA=unknown
ENV CINESPINE_VERSION=$GIT_SHA

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./

# No extras. `dev` is test tooling, and `hackathon` is the self-hosted
# mcp-clickhouse server -- this deployment points CLICKHOUSE_MCP_URL at
# ClickHouse Cloud's hosted MCP instead, and the client that talks to it is
# plain JSON-RPC over httpx with no dependency on that package.
#
# Both layers are cached on pyproject.toml/uv.lock alone, so application edits
# do not reinstall the dependency tree.
RUN uv sync --frozen --no-install-project

COPY backend/ ./backend/
COPY clickhouse/ ./clickhouse/
COPY data/ ./data/

RUN uv sync --frozen

# Where main.py looks: os.path.dirname(__file__)/../../frontend/dist.
COPY --from=frontend /build/dist ./frontend/dist

# Litestream replicates spine.db to Cloud Storage and restores it on boot, so
# a revision deploy no longer starts with an empty spine. One static binary;
# see deploy/litestream.yml for why this and not a Cloud Run volume.
COPY --from=litestream/litestream:0.3.13 /usr/local/bin/litestream /usr/local/bin/litestream
COPY deploy/litestream.yml deploy/entrypoint.sh ./deploy/
RUN chmod +x ./deploy/entrypoint.sh

# Documentation only -- Cloud Run ignores EXPOSE and injects $PORT.
EXPOSE 8080

# The venv interpreter directly, not `uv run`. uv re-checks the environment on
# every start, and in this image that cost 11.4 seconds compiling bytecode
# before uvicorn was even reached. Cloud Run charges that to every cold start.
#
# The entrypoint restores spine.db from the bucket, then runs that interpreter
# under `litestream replicate`. CINESPINE_LITESTREAM=0 skips both and runs
# uvicorn bare, for a local run of this image without GCS credentials.
CMD ["/app/deploy/entrypoint.sh"]
