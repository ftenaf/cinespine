[nix]
channel = "stable-23_11"

language = "python3"
run = "sh -c '.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000'"

[packager]
ignoredPackages = ["*"]
ignoredPaths = [".venv", "backend", "frontend"]

[packager.features]
packageSearch = false
guessImports = false
autoInstall = false



[workflows]
runButton = "Start CineSpine Platform"

[[workflows.workflow]]
name = "Start CineSpine Platform"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m venv .venv && .venv/bin/pip install -r backend/requirements.txt && cd frontend && npm install && npm run build && cd .. && .venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"

[[ports]]
localPort = 8000
externalPort = 80
