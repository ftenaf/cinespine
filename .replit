modules = ["python-3.12", "nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"

language = "python3"
run = "python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"

[packager]
ignoredPackages = ["*"]

[packager.features]
packageSearch = false
guessImports = false
autoInstall = false

[deployment]
build = ["sh", "-c", "pip install --break-system-packages -r backend/requirements.txt && cd frontend && npm install && npm run build"]
run = ["bash", "start.sh"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8000
externalPort = 80
