# =============================================================================
# CineSpine Environment Configuration
# =============================================================================

# Google Gemini & Imagen 3 API Key (Get free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI DALL-E 3 API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: ClickHouse Cloud OLAP Event Spine
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# Optional: Grafana Cloud Lighthouse Telemetry
# GRAFANA_OTLP_ENDPOINT=
# GRAFANA_API_KEY=
