{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Discrepancy Severity Gauge",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(cinespine_active_discrepancies{severity='CRITICAL'})",
          "legendFormat": "Critical Discrepancies",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "max": 20,
          "min": 0
        }
      }
    },
    {
      "title": "Paperwork Filed, by Department",
      "description": "Was a lag from wrap. A daily production report states wrap as a time of day with no date on it, and the only other timestamp is when the document reached this system, so the subtraction would have invented a number neither witness supports. This shows what is actually known: who has filed, and how much.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum by (department) (cinespine_ingested_events_total)",
          "legendFormat": "{{department}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Error Flow Breakdown by Department",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(cinespine_parser_rejections_total[5m])",
          "legendFormat": "{{doc_type}} - {{error_type}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cinespine", "telemetry", "lighthouse"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "CineSpine Lighthouse Observability",
  "version": 1
}
